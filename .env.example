# ==============================================================================
# Travelogue - VPS deployment settings (copy to .env next to docker-compose.yml)
# ==============================================================================

# --- Image ---
GHCR_OWNER=quana-ai
# "latest" or a commit SHA from GitHub Actions to pin / roll back
IMAGE_TAG=latest
HOST_PORT=3000

# --- Public URL(s) the app is served from, comma-separated ---
FRONTEND_ORIGINS=https://travelogue.example.com

# --- Supabase Database (required) ---
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.qqjxdzmogpjwyrehroun:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.qqjxdzmogpjwyrehroun:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# --- Secrets (required) ---
# JWT_SECRET / OTP_SECRET: openssl rand -hex 32
JWT_SECRET=
OTP_SECRET=
# ENCRYPTION_KEY must be exactly 32 characters: openssl rand -hex 16
# Never change it after bills are stored, or existing bills can't be decrypted.
ENCRYPTION_KEY=

# --- Supabase Storage (required) ---
# Project URL (Settings > Data API) and secret/service_role key (Settings > API Keys).
# Server-side only: never expose the key to the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket name (case-sensitive)
SUPABASE_BILLS_BUCKET=Bills

# --- Optional ---
JWT_EXPIRES_IN=7d
OCR_MIN_CONFIDENCE=35
